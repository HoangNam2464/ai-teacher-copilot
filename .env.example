# ==============================================================================
# AI Teacher Copilot for K-12 Teachers — Master Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env':
#      cp .env.example .env
# 2. Fill in your actual credentials and API keys below.
# 3. NEVER commit your actual '.env' file to Git / version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & NETWORKING
# ------------------------------------------------------------------------------
# Active environment profile: development | staging | production
APP_ENV=development

# Spring Boot Backend API Gateway Port
SERVER_PORT=8080

# FastAPI AI Service Port (Internal Service - do not expose to public internet)
FASTAPI_PORT=8000

# React Frontend Development Server Port
FRONTEND_PORT=5173

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL 16 + pgvector)
# ------------------------------------------------------------------------------
# Database Host (use 'localhost' for local dev, 'postgres' within docker network)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aiteachercopilot
POSTGRES_USER=aiteacher
POSTGRES_PASSWORD=changeme_db_password

# Database Connection Pool Settings (Spring Boot & AsyncPG)
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20

# ------------------------------------------------------------------------------
# 3. OBJECT STORAGE CONFIGURATION (MinIO / S3-Compatible)
# ------------------------------------------------------------------------------
# MinIO S3 API Endpoint
MINIO_ENDPOINT=http://localhost:9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme_minio_password

# S3 Buckets (Auto-created on initialization)
MINIO_BUCKET_DOCUMENTS=documents
MINIO_BUCKET_EXPORTS=exports

# ------------------------------------------------------------------------------
# 4. SECURITY & AUTHENTICATION (Spring Security + JWT)
# ------------------------------------------------------------------------------
# Base64 or 256-bit secret string for HMAC-SHA256 signing (Minimum 32 characters)
JWT_SECRET=changeme_jwt_secret_at_least_32_characters_long_for_hmac256

# Access Token Time-To-Live in milliseconds (86400000 ms = 24 hours)
JWT_EXPIRATION_MS=86400000

# Refresh Token Time-To-Live in milliseconds (604800000 ms = 7 days)
JWT_REFRESH_EXPIRATION_MS=604800000

# ------------------------------------------------------------------------------
# 5. AI PROVIDER & LLM CONFIGURATION (FastAPI AI Service)
# ------------------------------------------------------------------------------
# Primary AI Provider: 'gemini' | 'openai'
AI_PROVIDER=gemini

# Google Gemini API Configuration
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# OpenAI API Configuration (Optional / Fallback)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Generation Parameters
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=4096
AI_TIMEOUT_SECONDS=60

# ------------------------------------------------------------------------------
# 6. INTERNAL SERVICE-TO-SERVICE COMMUNICATION
# ------------------------------------------------------------------------------
# URL for Spring Boot to call FastAPI AI Service
AI_SERVICE_URL=http://localhost:8000

# Shared Secret Header (X-API-Key) to secure Spring Boot -> FastAPI internal requests
AI_SERVICE_API_KEY=changeme_internal_ai_service_shared_secret_key

# ------------------------------------------------------------------------------
# 7. FRONTEND CLIENT CONFIGURATION (Vite React Client)
# ------------------------------------------------------------------------------
# Base URL for frontend Axios client to call Spring Boot REST API
VITE_API_URL=http://localhost:8080/api
VITE_APP_TITLE="AI Teacher Copilot"
VITE_ENABLE_ANALYTICS=false

# ------------------------------------------------------------------------------
# 8. LOGGING & OBSERVABILITY
# ------------------------------------------------------------------------------
# Log Levels: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO
SPRING_LOG_LEVEL=INFO
FASTAPI_LOG_LEVEL=INFO
