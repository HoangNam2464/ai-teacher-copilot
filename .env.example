# ==================================================
# AI Teacher Copilot — Environment Configuration
# ==================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ==================================================

# ---- DATABASE ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aiteachercopilot
POSTGRES_USER=aiteacher
POSTGRES_PASSWORD=changeme_db_password

# ---- MINIO (S3-compatible file storage) ----
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme_minio_password
MINIO_BUCKET_DOCUMENTS=documents
MINIO_BUCKET_EXPORTS=exports

# ---- JWT ----
JWT_SECRET=changeme_jwt_secret_at_least_32_characters_long
JWT_EXPIRATION_MS=86400000

# ---- AI PROVIDER ----
# Options: openai, gemini
AI_PROVIDER=gemini

# ---- AI API KEYS ----
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---- AI SERVICE (FastAPI internal URL) ----
AI_SERVICE_URL=http://localhost:8000

# ---- SPRING BOOT ----
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ---- FASTAPI ----
FASTAPI_PORT=8000
FASTAPI_ENV=development
# Shared secret for Spring Boot → FastAPI internal calls
AI_SERVICE_API_KEY=changeme_internal_api_key
