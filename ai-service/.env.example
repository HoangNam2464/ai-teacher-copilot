# ==============================================================================
# AI Teacher Copilot — FastAPI AI Service Environment Configuration
# ==============================================================================
# Copy this file to '.env' inside the 'ai-service/' directory for standalone runs:
#   cp .env.example .env
# ==============================================================================

# Server & Environment
FASTAPI_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Internal Security Gateway (Validates requests from Spring Boot)
AI_SERVICE_API_KEY=changeme_internal_ai_service_shared_secret_key

# Database Connection (PostgreSQL 16 + pgvector)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://aiteacher:changeme_db_password@localhost:5432/aiteachercopilot

# AI Provider Selection ('gemini' | 'openai')
AI_PROVIDER=gemini

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# OpenAI Configuration (Fallback)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# RAG & Chunking Parameters
CHUNK_SIZE=512
CHUNK_OVERLAP=50
SIMILARITY_THRESHOLD=0.70
TOP_K_CHUNKS=5
