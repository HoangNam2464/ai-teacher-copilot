# ==============================================================================
# AI Teacher Copilot — Spring Boot Core Backend Environment Configuration
# ==============================================================================
# Copy this file to '.env' inside the 'backend/' directory for standalone runs:
#   cp .env.example .env
# ==============================================================================

# Server & Profile
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
LOG_LEVEL=INFO

# PostgreSQL 16 Connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aiteachercopilot
POSTGRES_USER=aiteacher
POSTGRES_PASSWORD=changeme_db_password

# Spring Security & JWT
JWT_SECRET=changeme_jwt_secret_at_least_32_characters_long_for_hmac256
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# MinIO Object Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme_minio_password
MINIO_BUCKET_DOCUMENTS=documents
MINIO_BUCKET_EXPORTS=exports

# Internal AI Service Gateway
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=changeme_internal_ai_service_shared_secret_key
