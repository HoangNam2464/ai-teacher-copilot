# =====================================================
# AI TEACHER COPILOT FRONTEND CONFIGURATION
# =====================================================
# Copy this file to .env and update with your values
# =====================================================

# API Configuration (Spring Boot Backend)
VITE_API_URL=http://localhost:8080/api

# OAuth - Google Sign-In
# Get from: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=

# OAuth - Apple Sign-In
# Get from: https://developer.apple.com/account/resources/identifiers/list/serviceId
VITE_APPLE_CLIENT_ID=
VITE_APPLE_REDIRECT_URI=http://localhost:5173/login

# Feature Flags
VITE_ENABLE_ANALYTICS=false
