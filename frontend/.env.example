# ==============================================================================
# AI Teacher Copilot — React (Vite) Frontend Client Environment Configuration
# ==============================================================================
# Copy this file to '.env' inside the 'frontend/' directory for local dev:
#   cp .env.example .env
# ==============================================================================

# Backend REST API Gateway URL (Spring Boot)
VITE_API_URL=http://localhost:8080/api

# Application Metadata
VITE_APP_TITLE=AI Teacher Copilot
VITE_APP_DESCRIPTION="Hệ thống AI hỗ trợ giáo viên K-12 tạo học liệu"

# Feature Flags
VITE_ENABLE_MOCK_API=false
VITE_ENABLE_ANALYTICS=false
